{
  "name": "starter",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "check-types": "tsc --noEmit",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:migrate": "tsx src/db/migrator.ts latest",
    "db:migrate:down": "tsx src/db/migrator.ts down",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "evlog": "^2.22.4",
    "express": "^5.2.1",
    "kysely": "^0.27.6",
    "pg": "^8.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
